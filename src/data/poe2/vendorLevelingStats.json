      "options": [
        { "id": "bow", "label": "Bows", "regex": "s: bow" },
        { "id": "staff", "label": "Staves", "regex": "s: st" },
        { "id": "mace2h", "label": "Two Hand Maces", "regex": "s: tw", "verify": true },
        { "id": "qstaff", "label": "Quarterstaves", "regex": "s: qua" },
        { "id": "crossbow", "label": "Crossbows", "regex": "s: cr" }
      ]
    },
    {
      "label": "Equipment",
      "options": [
        { "id": "gloves", "label": "Gloves", "regex": "s: gl" },
        { "id": "boots", "label": "Boots", "regex": "s: boo" },
        { "id": "body", "label": "Body Armours", "regex": "s: bod", "verify": true },
        { "id": "helmet", "label": "Helmets", "regex": "s: he", "verify": true }
      ]
    },
    {
      "label": "Offhand",
      "options": [
        { "id": "quiver", "label": "Quivers", "regex": "s: qui", "verify": true },
        { "id": "focus", "label": "Foci", "regex": "s: fo", "verify": true },
        { "id": "shield", "label": "Shields", "regex": "s: sh", "verify": true }
      ]
    }
  ]
}
